# Database Connection (PostgreSQL - Neon, cloud PostgreSQL, or local PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/college_erp
DB_SSL=false
DB_SCHEMA=erp

# Server & Session Settings
PORT=4000
SESSION_SECRET=change-this-to-a-secure-random-64-character-hex-string
COOKIE_SECURE=false

# Initial Seed Settings
SEED_PASSWORD=DemoPassword123!

# ── Email OTP sign-in (Resend) ──────────────────────────────
# Create a key at https://resend.com/dashboard/api-keys
# Note: without a verified sending domain, Resend delivers only to your own
# account email and uses the onboarding@resend.dev sender.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
OTP_SENDER_EMAIL=onboarding@resend.dev
OTP_SENDER_NAME=Mini College ERP
